# ── Core ──────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# ── Database ──────────────────────────────────────
# Leave DATABASE_URL unset to use local SQLite (backend/jaggery.db)
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── Redis / Celery (optional in dev; tasks run eagerly if unset) ──
REDIS_URL=

# ── Mail (SMTP, optional — order emails are skipped if unset) ──
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=KhagRaj <noreply@khagraj.in>

# ── CORS ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Admin seed account ────────────────────────────
ADMIN_EMAIL=khagrajindia2017@gmail.com
ADMIN_PASSWORD=Admin@2025
ADMIN_NAME=Admin


# ── Uploads ───────────────────────────────────────
UPLOAD_FOLDER=
PORT=5000
